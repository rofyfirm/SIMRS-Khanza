	<queryString>
		<![CDATA[select reg_periksa.no_rawat,pasien.no_rkm_medis,pasien.nm_pasien,reg_periksa.umurdaftar,reg_periksa.sttsumur,pasien.jk,pasien.tgl_lahir,
c_ssrs.tgl_perawatan,c_ssrs.jam_rawat,
c_ssrs.berharap_mati,
c_ssrs.frekuensi_berharap_mati,
c_ssrs.ide_bunuh_diri,
c_ssrs.frekuensi_ide_bunuh_diri,
c_ssrs.rencana_spesifik,
c_ssrs.frekuensi_rencana_spesifik,
c_ssrs.niat_melukai_diri,
c_ssrs.frekuensi_niat_melukai_diri,
c_ssrs.niat_dengan_rencana,
c_ssrs.frekuensi_niat_dengan_rencana,
c_ssrs.percobaan_bunuh_diri,
c_ssrs.jumlah_percobaan_bunuh_diri,
c_ssrs.tindakan_persiapan,
c_ssrs.jumlah_tindakan_persiapan,
c_ssrs.ide_metode,
c_ssrs.jumlah_ide_metode,
c_ssrs.situasi_berisiko,
c_ssrs.jumlah_situasi_berisiko,
c_ssrs.nip,petugas.nama from c_ssrs 
inner join reg_periksa on c_ssrs.no_rawat=reg_periksa.no_rawat 
inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis 
inner join petugas on c_ssrs.nip=petugas.nip]]>
	</queryString>
