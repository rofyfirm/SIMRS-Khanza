			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="266aa5f3-7e88-4a7a-bc55-e134439f822e"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Agak berat : Pasien menunjukkan berkurangnya spontanitas dan keterbukaan yang mencolok, menjawab pertanyaan pewawancara dengan hanya 1 atau 2 kalimat singkat."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
