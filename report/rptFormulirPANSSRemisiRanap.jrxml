					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Berat : Cenderung menjadi apatis dan terisolasi, sangat jarang berpartisipasi dalam aktivitas sosial dan sekali-kali mengabaikan kebutuhan pribadi, kontak sosial yang spontan sangat sedikit."]]></textFieldExpression>
			</textField>
