	<detail>
		<band height="14" splitType="Prevent">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="0" y="0" width="555" height="14" uuid="1fe0287e-12dc-4225-b4b7-38400d92b56c"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold=\"true\">P1. WAHAM</style>\nKeyakinan yang tidak mempunyai dasar, tidak realistik dan aneh (idiosinkratik).\nDasar penilaian : Isi pikiran yang diekspresikan dalam wawancara dan pengaruhnya terhadap relasi sosial dan perilaku."]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="3253c783-35d3-4023-844a-c27a2e9cc954"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[1]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="6aedfe14-ef6b-427a-a95e-80eefe0a7a93"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Tidak ada : Definisi tidak dipenuhi."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="99d656bd-1421-4a09-8d33-2b549fb19c33"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["1".equals($F{p1_masuk})?"√":""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="0" width="55" height="12" uuid="059a9d09-44fd-4dc7-9939-4234100ae0e4"/>
