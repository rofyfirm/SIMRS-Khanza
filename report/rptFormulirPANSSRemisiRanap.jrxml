					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Ringan : Kejanggalan ringan dalam pergerakan atau kekakuan sikap tubuh yang ringan."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
