					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["4".equals($F{n1_keluar})?"√":""]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="3700258f-aa37-4b1f-bd2a-b42a271b4dff"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[5]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="a9d3b6f8-67e3-4d3d-ba0a-936eb40e2771"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Agak berat : Afek umumnya datar dengan hanya sekali-sekali tampak perubahan ekspresi wajah dan gerak gerik komunikatif sedikit."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="1379a9fc-3090-4452-b6a5-140b18a05376"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["5".equals($F{n1_masuk})?"√":""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="0" width="55" height="12" uuid="c2fb6d8f-62d0-456f-b360-3817d265e0cf"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["5".equals($F{n1_keluar})?"√":""]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="dca8b408-821f-449a-8fb5-541b9c8ca49f"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[6]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="a24ca094-4f8d-4ae5-b598-a7ab97d009ed"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Berat : Pendataran dan defisiensi emosi yang mencolok yang tampak hampir sepanjang waktu. Kemungkinan terdapat pelepasan afek ekstrim yang tidak bergelombang seperti \"excitement\", kemarahan atau tertawa yang tidak terkendali yang tidak serasi."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="a4253646-09d6-44bb-8134-78b31b8b28ce"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["6".equals($F{n1_masuk})?"√":""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="0" width="55" height="12" uuid="d2830b6d-2e54-4e0d-be02-8b9bfbdb63ed"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["6".equals($F{n1_keluar})?"√":""]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="a56e2a5e-eb84-4e1d-b786-905d1682f203"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[7]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="8f00303e-01a7-44d9-8373-5dbd34956454"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Sangat berat : Jelas tidak tampak perubahan ekspresi wajah dan adanya gerak gerik komunikatif. Pasien terus menerus menampakkan ekspresi yang \"tidak hidup\" atau berwajah \"kayu\"."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="8b2e58ef-4c0e-46af-a06c-30e10213676c"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["7".equals($F{n1_masuk})?"√":""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="0" width="55" height="12" uuid="b7e5981c-dad9-409f-84f4-f4c5bceb4f55"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["7".equals($F{n1_keluar})?"√":""]]></textFieldExpression>
			</textField>
		</band>
		<band height="14" splitType="Prevent">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="0" y="0" width="555" height="14" uuid="1072b77a-540e-4916-9372-2456b390f053"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold=\"true\">N4. PENARIKAN DIRI DARI HUBUNGAN SOSIAL SECARA PASIF/APATIS</style>\nBerkurangnya minat dan inisiatif dalam interaksi sosial, yang disebabkan oleh pasivitas, apatis, anergi atau tidak ada dorongan kehendak. Hal ini mengarah pada berkurangnya keterlibatan interpersonal dan mengabaikan aktivitas kehidupan sehari-hari."]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="7d273e94-f3fc-40fb-a308-15956c131e8d"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[1]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="b6551c25-bac7-4142-891b-93baf386f04e"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Tidak ada : Definisi tidak dipenuhi."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="70bac8c6-518c-418c-91af-598bbf073d30"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["1".equals($F{n4_masuk})?"√":""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="0" width="55" height="12" uuid="94b6ff99-6cd5-4234-993d-9031f6d54b98"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
