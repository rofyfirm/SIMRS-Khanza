				</textElement>
				<textFieldExpression><![CDATA["1".equals($F{p1_keluar})?"√":""]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="eee08137-cf97-4243-9949-218ed9d33bc5"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[2]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="4567653c-853e-4e54-9192-5f404c5d1188"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Minimal : Patologis diragukan; mungkin suatu ujung ekstrim dari batasan normal."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="f7d37ebd-cd00-414e-a891-24bf513e5460"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["2".equals($F{p1_masuk})?"√":""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
