			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="a05bf19b-e5d3-4aae-a0eb-8cc4fad6082f"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Agak berat : Adanya beberapa waham yang berbentuk jelas, yang dipertahankan dan kadang-kadang mempengaruhi proses pikir, relasi sosial atau perilaku."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
