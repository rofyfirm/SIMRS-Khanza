		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="2f2a6da3-3253-4523-bd46-00dd583d9abc"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[2]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="87f5fa7b-1188-40ff-a46c-9c3d1b0e3839"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Minimal : Patologis diragukan; mungkin suatu ujung ekstrim dari batasan normal."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="4da8c77b-0456-4fa5-9e9a-a5a084ebf447"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["2".equals($F{p2_masuk})?"√":""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="0" width="55" height="12" uuid="3c012b32-ad65-4c70-b70e-f89606449683"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["2".equals($F{p2_keluar})?"√":""]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="7f9b84a8-9e81-4743-95ba-e6b88081c038"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[3]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="4562cb22-2058-4f95-91a6-99d563f4fea8"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Ringan : Proses pikir sirkumstansial, tangensial atau paralogikal. Adanya kesulitan dalam mengarahkan pikiran ke tujuan dan kadang-kadang asosiasi longgar dapat dijumpai di bawah tekanan."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="6a12918f-701a-47fa-9010-2935f14136f2"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["3".equals($F{p2_masuk})?"√":""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="0" width="55" height="12" uuid="870657e9-edef-43ba-8a47-4d94f11851ed"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["3".equals($F{p2_keluar})?"√":""]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="8238d397-e651-4540-927c-1eb702cdf5d8"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[4]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="6b0f07d2-ab78-4d7b-b2e0-43dfb20f7e30"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Sedang : Mampu memusatkan pikiran bila komunikasi singkat dan terstruktur, tetapi menjadi longgar atau tidak relevan bila menghadapi komunikasi yang lebih kompleks atau bila di bawah tekanan minimal."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="15fd62d8-8d51-469e-91a0-ca8da0640b18"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["4".equals($F{p2_masuk})?"√":""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="0" width="55" height="12" uuid="f8dec021-6892-4b30-a4d1-0a9e0ab88b9b"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["4".equals($F{p2_keluar})?"√":""]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="28cce3be-78b7-4300-b387-446446e2c786"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[5]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="199cae0e-2009-4a1b-aeb2-214909d42ef4"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Agak berat : Secara umum mengalami kesulitan dalam menata pikiran yang terbukti dalam bentuk sering tidak relevan, tidak ada hubungan, atau asosiasi longgar bahkan walaupun tanpa tekanan."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="4d6ab2a4-c59f-4ef8-8868-f83c3dcc3cda"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["5".equals($F{p2_masuk})?"√":""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="0" width="55" height="12" uuid="0e93e2a2-9a77-40a4-8082-5e0a513249e5"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["5".equals($F{p2_keluar})?"√":""]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="028c0cf5-6419-4ad0-a2b1-d9e99ac511b9"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[6]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="d20f735c-1901-40f0-8d34-8ae9c98ee94c"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Berat : Proses pikir (thinking) sangat menyimpang dan pada dasarnya (internally) tidak konsisten, mengakibatkan tidak relevan yang parah dan kekacauan proses pikir, yang hampir terjadi terus menerus."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="fb38174e-a9e1-4159-98af-9fcff5f3b884"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["6".equals($F{p2_masuk})?"√":""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="0" width="55" height="12" uuid="defe6d22-262a-45ec-8a45-46081d66e3df"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["6".equals($F{p2_keluar})?"√":""]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="e5b7538e-7a86-4c14-95ca-3008dd928ae7"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[7]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="0f6b05b3-732f-46e7-bc25-6d6dba1f285b"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Sangat berat : Pikiran (thought) sangat kacau sehingga menjadi inkoheren. Asosiasi longgar yang sangat jelas, yang mengakibatkan kegagalan total dalam komunikasi, misalnya: \"word-salad\" atau mutisme."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="555caeeb-37c9-4953-b579-40b60423123c"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["7".equals($F{p2_masuk})?"√":""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="0" width="55" height="12" uuid="bff2cbe5-d329-4d95-b8b7-212cbfc0ca60"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["7".equals($F{p2_keluar})?"√":""]]></textFieldExpression>
			</textField>
		</band>
		<band height="14" splitType="Prevent">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="0" y="0" width="555" height="14" uuid="aec3ff40-eea3-4ac0-95b5-eaff36eaa1c1"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold=\"true\">P3. PERILAKU HALUSINASI</style>\nLaporan secara verbal atau perilaku yang menunjukkan persepsi yang tidak dirangsang oleh stimulasi luar. Dapat terjadi halusinasi pendengaran, penglihatan, penciuman atau somatik.\nDasar penilaian : Laporan verbal dan manifestasi fisik selama wawancara, dan juga perilaku yang dilaporkan oleh perawat atau keluarga."]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="177f867f-1dfd-41da-8c36-3081d223e544"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[1]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="b511493b-4dcb-41fa-92e5-7a1cc415bfd6"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Tidak ada : Definisi tidak dipenuhi."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="9b4fd6ae-52cd-43c4-a27d-57472d9c09c4"/>
