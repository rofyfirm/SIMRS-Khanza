					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Sedang : Secara pasif ikut dalam sebagian besar aktivitas sosial tetapi dengan cara \"ogah-ogahan\" (disinterested) atau secara mekanis. Cenderung untuk ada di baris belakang."]]></textFieldExpression>
			</textField>
