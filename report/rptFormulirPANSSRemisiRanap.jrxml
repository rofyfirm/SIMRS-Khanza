			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="3453fdd1-2f21-4cff-b3d3-1afadaca072d"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Sedang : Arus percakapan kurang bebas dan tidak lancar atau terhenti-henti. Pertanyaan terarah sering dibutuhkan untuk mendapatkan respons yang adekuat dan untuk melanjutkan percakapan."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
