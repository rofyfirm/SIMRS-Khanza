			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="3a3edf4e-8e52-49ae-bbba-1915b7a7a4d1"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[4]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="63a9723b-71fb-4786-a105-fde097713d55"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Sedang : Berkurangnya corak ekspresi wajah dan sedikitnya gerak gerik ekspresif yang tampak dalam penampilan yang tumpul (dull)."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="e7f135f4-d92c-4c63-acba-5896c797a79a"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["4".equals($F{n1_masuk})?"√":""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="0" width="55" height="12" uuid="b75a6031-972b-4555-9198-d00c8aebf02e"/>
				<box><pen lineWidth="0.75"/></box>
