					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Sedang : Adanya rangkaian waham yang bentuknya kurang jelas dan tidak stabil atau beberapa waham yang berbentuk jelas, yang kadang-kadang mempengaruhi proses pikir, relasi sosial atau perilaku."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
