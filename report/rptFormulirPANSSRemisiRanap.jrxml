			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="30" y="0" width="415" height="12" uuid="6735b02f-38e5-4715-9cf4-c67133e08e71"/>
				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Ringan : Ada satu atau dua waham yang samar-samar, tidak terkristalisasi, dan tidak bertahan. Waham tidak mempengaruhi proses pikir, relasi sosial atau perilaku."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
