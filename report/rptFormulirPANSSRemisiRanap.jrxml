				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Minimal : Patologis diragukan; mungkin suatu ujung ekstrim dari batasan normal."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="445" y="0" width="55" height="12" uuid="a7324cfa-23c8-40b9-96c0-a0cea4ec3f44"/>
