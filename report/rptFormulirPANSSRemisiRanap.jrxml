	<field name="g9_masuk" class="java.lang.String"/>
	<field name="p1_keluar" class="java.lang.String"/>
	<field name="p2_keluar" class="java.lang.String"/>
	<field name="p3_keluar" class="java.lang.String"/>
	<field name="n1_keluar" class="java.lang.String"/>
