	<field name="n6_keluar" class="java.lang.String"/>
	<field name="g5_keluar" class="java.lang.String"/>
	<field name="g9_keluar" class="java.lang.String"/>
	<variable name="total_masuk" class="java.lang.Integer">
		<variableExpression><![CDATA[$F{p1_masuk}==null?null:Integer.valueOf(Integer.parseInt($F{p1_masuk})+Integer.parseInt($F{p2_masuk})+Integer.parseInt($F{p3_masuk})+Integer.parseInt($F{n1_masuk})+Integer.parseInt($F{n4_masuk})+Integer.parseInt($F{n6_masuk})+Integer.parseInt($F{g5_masuk})+Integer.parseInt($F{g9_masuk}))]]></variableExpression>
	</variable>
	<variable name="total_keluar" class="java.lang.Integer">
		<variableExpression><![CDATA[$F{p1_keluar}==null?null:Integer.valueOf(Integer.parseInt($F{p1_keluar})+Integer.parseInt($F{p2_keluar})+Integer.parseInt($F{p3_keluar})+Integer.parseInt($F{n1_keluar})+Integer.parseInt($F{n4_keluar})+Integer.parseInt($F{n6_keluar})+Integer.parseInt($F{g5_keluar})+Integer.parseInt($F{g9_keluar}))]]></variableExpression>
	</variable>
