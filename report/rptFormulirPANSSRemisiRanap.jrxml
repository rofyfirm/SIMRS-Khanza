				<box leftPadding="3" rightPadding="3" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Agak berat : Secara pasif berpartisipasi dalam hanya sedikit aktivitas sosial dan menunjukkan jelas tidak ada minat atau inisiatif. Umumnya menyendiri."]]></textFieldExpression>
			</textField>
