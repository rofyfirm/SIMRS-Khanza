			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="0" width="55" height="12" uuid="f1cf20be-2ce2-4c6c-8b87-19a7f4a5b55b"/>
				<box><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["5".equals($F{p1_keluar})?"√":""]]></textFieldExpression>
