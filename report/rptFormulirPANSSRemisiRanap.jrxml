		<band height="14" splitType="Prevent">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="0" y="0" width="555" height="14" uuid="1e51e1ac-ac7b-4f91-bf08-798af54ff8eb"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold=\"true\">G9. ISI PIKIRAN YANG TIDAK BIASA</style>\nProses pikir ditandai oleh ide-ide yang asing, fantastik, atau bizar, berkisar dari yang ringan atau atipikal sampai distorsi, tidak logis dan sangat tidak masuk akal.\nDasar penilaian : Isi pikir yang diekspresikan selama wawancara."]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
