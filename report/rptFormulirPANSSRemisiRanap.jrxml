					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Ringan : Sesekali menunjukkan minat dalam aktivitas sosial, tetapi inisiatif sangat kurang. Biasanya keterlibatan dengan orang lain hanya bila \"didekati\" oleh orang lain tersebut."]]></textFieldExpression>
