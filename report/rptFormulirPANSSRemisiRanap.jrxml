					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold=\"true\">N6. KURANGNYA SPONTANITAS DAN ARUS PERCAKAPAN</style>\nBerkurangnya arus normal percakapan yang disertai dengan apatis, avolisi (tidak ada dorongan kehendak), defensif atau defisit kognitif."]]></textFieldExpression>
