		<band height="14" splitType="Prevent">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="0" y="0" width="555" height="14" uuid="9811e836-6522-4738-bd41-8a60390c835d"/>
				<box leftPadding="3" rightPadding="3" topPadding="1" bottomPadding="1"><pen lineWidth="0.75"/></box>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold=\"true\">G5. MANNERISME DAN SIKAP TUBUH</style>\nGerakan atau sikap tubuh yang tidak wajar seperti yang ditandai oleh kejanggalan, kaku, disorganisasi, atau penampilan yang bizar.\nDasar penilaian : Observasi tentang manifestasi fisik selama wawancara dan laporan dari perawat atau keluarga."]]></textFieldExpression>
			</textField>
		</band>
		<band height="12" splitType="Prevent">
			<staticText>
				<reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="30" height="12" uuid="fe5ab05a-23d4-43a7-92a1-e6de9507de96"/>
