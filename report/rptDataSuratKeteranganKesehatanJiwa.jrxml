surat_keterangan_kesehatan_jiwa.kesimpulan,surat_keterangan_kesehatan_jiwa.keperluan from surat_keterangan_kesehatan_jiwa
inner join reg_periksa on surat_keterangan_kesehatan_jiwa.no_rawat=reg_periksa.no_rawat
inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis
inner join dokter on surat_keterangan_kesehatan_jiwa.kd_dokter=dokter.kd_dokter]]>
